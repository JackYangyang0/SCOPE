  "strategy_dependency_notes": [
    "Packing must be selected before SIMD micro-kernel construction.",
    "Micro-kernel shape determines which vectorization policy is legal.",
    "OpenMP strategies should be paired with CPU.Compiler.NativeO3OpenMP or CPU.Compiler.MSVC.AVX2OpenMP.",
    "Compiler flags are explicit strategies so generated code and verifier use matching assumptions.",
    "OpenMP packed-panel code must use thread-private or tile-private buffers before any parallel tile schedule is selected.",
    "Intel SIMD micro-kernels must use N-lane accumulator vectors: broadcast A scalar, load contiguous B panel/N columns, and reduce K sequentially.",
    "OpenBLASPanelMajor is a portable structural strategy inspired by OpenBLAS/QiMeng drivers; ISA-specific compute remains backend-specific.",
    "Throughput CPU paths may relax inner full-tile boundary checks only when CPU.TailKernel.FullTileFastPathScalarCleanup is present.",
    "CPU.MacroKernel.OpenBLASStyle.PanelDriver must appear before OpenBLASPanelMajor loop scheduling.",
    "PackA/PackB implementation strategies are separate from selecting packed-memory flags; code generation must emit real copy loops."
  ],
  "requires": {
    "CPU.Memory.PackBuffer.ThreadPrivate": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Memory.PackB.ContiguousPanel",
          "CPU.Memory.PackA.ContiguousPanel",
          "CPU.Memory.PackAB.PanelMajor",
          "CPU.Packing.PackA.MRxKC",
          "CPU.Packing.PackB.KCxNR",
          "CPU.Packing.PackAB.MRxKC_KCxNR"
        ]
      }
    ],
    "CPU.Memory.PackBuffer.TilePrivate": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Memory.PackB.ContiguousPanel",
          "CPU.Memory.PackA.ContiguousPanel",
          "CPU.Memory.PackAB.PanelMajor",
          "CPU.Packing.PackA.MRxKC",
          "CPU.Packing.PackB.KCxNR",
          "CPU.Packing.PackAB.MRxKC_KCxNR"
        ]
      }
    ],
    "CPU.Memory.Prefetch.BPanel": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Memory.PackB.ContiguousPanel",
          "CPU.Memory.PackAB.PanelMajor",
          "CPU.Packing.PackB.KCxNR",
          "CPU.Packing.PackAB.MRxKC_KCxNR"
        ],
        "required_state": {
          "cpu_memory.pack_b": true
        }
      }
    ],
    "CPU.Memory.Prefetch.ABPanel": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Memory.PackAB.PanelMajor",
          "CPU.Packing.PackAB.MRxKC_KCxNR"
        ],
        "required_state": {
          "cpu_memory.pack_a": true,
          "cpu_memory.pack_b": true
        }
      }
    ],
    "CPU.MicroKernel.Scalar.4x4": [
      {
        "required_state": {
          "cpu_tiling.register_m": 4,
          "cpu_tiling.register_n": 4
        }
      }
    ],
    "CPU.MicroKernel.AVX2.FMA.4x8": [
      {
        "required_state": {
          "cpu_tiling.register_m": 4,
          "cpu_tiling.register_n": 8
        }
      }
    ],
    "CPU.MicroKernel.AVX2.FMA.6x16": [
      {
        "required_state": {
          "cpu_tiling.register_m": 6,
          "cpu_tiling.register_n": 16
        }
      }
    ],
    "CPU.MicroKernel.AVX512.FMA.8x16": [
      {
        "required_state": {
          "cpu_tiling.register_m": 8,
          "cpu_tiling.register_n": 16
        }
      }
    ],
    "CPU.MicroKernel.AVX2.FMA.4x16": [
      {
        "required_state": {
          "cpu_tiling.register_m": 4,
          "cpu_tiling.register_n": 16
        }
      }
    ],
    "CPU.Vectorization.AVX2.FMA.Explicit": [
      {
        "mode": "any",
        "strategies": [
          "CPU.MicroKernel.AVX2.FMA.4x8",
          "CPU.MicroKernel.AVX2.FMA.6x16",
          "CPU.MicroKernel.AVX2.FMA.4x16"
        ],
        "required_state": {
          "cpu_microkernel.family": "avx2_fma"
        }
      }
    ],
    "CPU.Vectorization.AVX512.FMA.Explicit": [
      {
        "mode": "all",
        "strategies": [
          "CPU.MicroKernel.AVX512.FMA.8x16"
        ],
        "required_state": {
          "cpu_microkernel.family": "avx512_fma"
        }
      }
    ],
    "CPU.Vectorization.ScalarPortable": [
      {
        "mode": "all",
        "strategies": [
          "CPU.MicroKernel.Scalar.4x4"
        ],
        "required_state": {
          "cpu_microkernel.family": "scalar"
        }
      }
    ],
    "CPU.MacroKernel.OpenBLASStyle.PanelDriver": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Memory.PackBuffer.ThreadPrivate",
          "CPU.Memory.PackBuffer.TilePrivate"
        ],
        "required_state": {
          "cpu_memory.pack_b": true
        }
      }
    ],
    "CPU.LoopOrder.OpenBLASPanelMajor": [
      {
        "mode": "all",
        "strategies": [
          "CPU.MacroKernel.OpenBLASStyle.PanelDriver"
        ]
      }
    ],
    "CPU.LoopOrder.PackedPanelMajor": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Memory.PackB.ContiguousPanel",
          "CPU.Memory.PackA.ContiguousPanel",
          "CPU.Memory.PackAB.PanelMajor",
          "CPU.Packing.PackA.MRxKC",
          "CPU.Packing.PackB.KCxNR",
          "CPU.Packing.PackAB.MRxKC_KCxNR"
        ]
      }
    ],
    "CPU.Threading.OpenMP.TilePartition": [
      {
        "mode": "any",
        "strategies": [
          "CPU.MacroKernel.OpenBLASStyle.PanelDriver",
          "CPU.MacroKernel.DirectTiled.Driver"
        ],
        "required_state": {
          "cpu_macro_kernel.calls_microkernel_grid": true
        }
      }
    ],
    "CPU.Compiler.NativeO3OpenMP": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Parallel.OpenMP.RowBlock",
          "CPU.Parallel.OpenMP.Collapse2",
          "CPU.Threading.OpenMP.TilePartition"
        ]
      }
    ],
    "CPU.Compiler.PortableO2": [
      {
        "mode": "all",
        "strategies": [
          "CPU.Parallel.Serial"
        ],
        "required_state": {
          "cpu_parallel.policy": "serial"
        }
      }
    ],
    "CPU.Compiler.NativeO3": [
      {
        "mode": "all",
        "strategies": [
          "CPU.Parallel.Serial"
        ],
        "required_state": {
          "cpu_parallel.policy": "serial"
        }
      }
    ],
    "CPU.Compiler.MSVC.AVX2OpenMP": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Parallel.OpenMP.RowBlock",
          "CPU.Parallel.OpenMP.Collapse2",
          "CPU.Threading.OpenMP.TilePartition"
        ]
      },
      {
        "mode": "all",
        "strategies": [
          "CPU.Vectorization.AVX2.FMA.Explicit"
        ],
        "required_state": {
          "cpu_vectorization.isa": "avx2_fma"
        }
      }
    ],
    "CPU.Compiler.NativeO3FastMathOpenMP": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Parallel.OpenMP.RowBlock",
          "CPU.Parallel.OpenMP.Collapse2",
          "CPU.Threading.OpenMP.TilePartition"
        ]
      },
      {
        "mode": "all",
        "strategies": [
          "CPU.Vectorization.AVX2.FMA.Explicit"
        ],
        "required_state": {
          "cpu_vectorization.isa": "avx2_fma"
        }
      }
    ],
    "CPU.TailKernel.FullTileFastPathScalarCleanup": [
      {
        "mode": "any",
        "strategies": [
          "CPU.Vectorization.AVX2.FMA.Explicit",
          "CPU.Vectorization.AVX512.FMA.Explicit"
        ],
        "required_state": {
          "cpu_vectorization.tail_handling": true
        }
      }
    ]
  },
  "fallback": {
    "CPU.MicroKernel.AVX512.FMA.8x16": [
      {
        "strategies": [
          "CPU.MicroKernel.AVX2.FMA.4x8",
          "CPU.MicroKernel.Scalar.4x4"
        ]
      }
    ],
    "CPU.Packing.PackAB.MRxKC_KCxNR": [
      {
        "strategies": [
          "CPU.Memory.PackB.ContiguousPanel",
          "CPU.Memory.NoPack"
        ]
      }
    ]
  }
